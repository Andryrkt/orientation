# Modèle de configuration de PRODUCTION pour OrientMad.
# Copie ce fichier vers `.env` sur le serveur de production et remplace TOUTES
# les valeurs marquées CHANGE_ME. Ne commite jamais le `.env` réel.
#
# Utilisation :
#   cp .env.production.example .env
#   docker compose -f docker-compose.prod.yml up --build -d

# --- PostgreSQL ---
POSTGRES_USER=orientmad
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32
POSTGRES_DB=orientmad

# --- Backend ---
# En prod avec docker-compose.prod.yml, le backend joint la base via le nom de service "db".
DATABASE_URL=postgresql://orientmad:CHANGE_ME_generate_with_openssl_rand_base64_32@db:5432/orientmad?schema=public
BACKEND_PORT=3000

# Secrets JWT : générer des valeurs distinctes et aléatoires, ex. `openssl rand -hex 64`
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_64
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_64
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Domaine public du frontend (celui qui appelle l'API) — requis pour CORS et les cookies.
FRONTEND_ORIGIN=https://CHANGE_ME.mg

# En production, le trafic est en HTTPS (via un reverse proxy devant les conteneurs) :
# les cookies doivent être marqués "secure".
COOKIE_SECURE=true

# Désactive la documentation Swagger publique (/api/docs) en production.
# Passe à "true" temporairement si tu as besoin d'y accéder en prod.
SWAGGER_ENABLED=false

# --- Frontend ---
# URL publique de l'API, injectée au moment du build (Vite) : doit être joignable
# depuis le navigateur des utilisateurs, donc jamais "http://backend:3000".
VITE_API_URL=https://CHANGE_ME-api.mg
FRONTEND_PORT=80
