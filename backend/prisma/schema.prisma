generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VISITOR
  STUDENT
  COACH
  TEACHER
  ADMIN
  SECRETAIRE
  MODERATEUR
  MODERATEUR_FINANCE
}

enum Periode {
  MIDI
  APRES_MIDI
}

enum NiveauMention {
  BTS
  LICENCE
  MASTER
  DOCTORAT
}

enum FavorisableType {
  METIER
  UNIVERSITE
  STAGE
  BOURSE
  COACH
  CENTRE_FORMATION
  ENSEIGNANT
}

enum CommentaireStatut {
  EN_ATTENTE
  APPROUVE
  REJETE
}

enum TypeQuestion {
  CHOIX_MULTIPLE
  ECHELLE
  TEXTE
}

model Utilisateur {
  id               String    @id @default(uuid())
  nom              String
  prenom           String
  email            String    @unique
  telephone        String?   @unique
  password         String?
  googleId         String?   @unique
  role             Role      @default(STUDENT)
  emailVerifiedAt  DateTime?
  refreshTokenHash String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  profil               Profil?
  favoris              Favori[]
  blogs                Blog[]
  blogLikes            BlogLike[]
  commentaires         BlogCommentaire[]
  resultatsOrientation ResultatOrientation[]
  coachProfil          Coach?
  avisCoachs           CoachAvis[]
  enseignantProfil     Enseignant?
  avisEnseignants      EnseignantAvis[]
  tickets              Ticket[]
  ticketMessages       TicketMessage[]

  pointDeVenteId      String?
  pointDeVente        PointDeVente?       @relation("SecretairesPointDeVente", fields: [pointDeVenteId], references: [id], onDelete: SetNull)
  saisiesJournalieres SaisieJournaliere[]
  mouvementsCaisse    MouvementCaisse[]

  @@map("utilisateurs")
}

model Profil {
  id            String    @id @default(uuid())
  utilisateurId String    @unique
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  dateNaissance DateTime?
  sexe          String?
  region        String?
  adresse       String?
  niveauEtude   String?
  photo         String?
  bio           String?
  interets      String[]  @default([])
  titreCv       String?
  experiences   Json      @default("[]")
  formations    Json      @default("[]")
  competences   Json      @default("[]")
  langues       Json      @default("[]")

  @@map("profils")
}

model Domaine {
  id          String   @id @default(uuid())
  nom         String
  slug        String   @unique
  description String?
  icone       String?
  ordre       Int      @default(0)
  riasecCodes String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  metiers  Metier[]
  mentions Mention[]
  stages   Stage[]
  bourses  Bourse[]

  @@map("domaines")
}

model Metier {
  id                  String   @id @default(uuid())
  domaineId           String
  domaine             Domaine  @relation(fields: [domaineId], references: [id], onDelete: Restrict)
  nom                 String
  slug                String   @unique
  description         String?
  imageBanniere       String?
  missions            String[] @default([])
  competences         Json     @default("[]")
  salaireMin          Int?
  salaireMax          Int?
  niveauRequis        String?
  perspectivesEmploi  String?
  riasecCodes         String[] @default([])

  // Section 1 - Identification
  autresAppellations  String[] @default([])
  sousDomaine         String?
  secteursActivite    String[] @default([])
  codeRome            String?

  // Section 2 - Environnement de travail
  environnementTravail String[] @default([])
  environnementAutre   String?

  // Section 3 - Competences
  competencesComportementales String[] @default([])
  languesRequises             String[] @default([])
  niveauLangues                String?

  // Section 4 - Formation et parcours d'acces
  specialiteDiplome     String?
  formationsMadagascar  String[] @default([])
  certifications        String[] @default([])
  autoFormation         String?

  // Section 5 - Conditions de travail et remuneration
  salaireSource       String?
  typeContrat         String[] @default([])
  volumeHoraire       String[] @default([])
  penibilitePhysique  Int?
  penibiliteStress    Int?
  penibiliteRisques   Int?
  avantages           String?

  // Section 6 - Marche de l'emploi a Madagascar
  niveauDemande           String?
  regionsPresence         String[] @default([])
  postesEvolution         String?
  mobiliteInternationale  String?
  tendances               String[] @default([])
  employeurs              String[] @default([])

  // Section 7 - Profil type et personnalite
  traitsPersonnalite       String[] @default([])
  centresInteret           String[] @default([])
  valeursProfessionnelles  String[] @default([])
  profilIntroExtraverti    String?

  // Section 8 - Temoignage professionnel
  temoignagePrenom             String?
  temoignageAnneesExperience   Int?
  temoignageVille              String?
  temoignageSecteurEmployeur   String?
  temoignageCePlait            String?
  temoignageDifficultes        String?
  temoignageConseil            String?
  temoignageCitation           String?
  temoignageAccordPublication  String?

  // Section 9 - Sources et validation
  sources       String[] @default([])
  fiabilite     String?
  observations  String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("metiers")
}

model Universite {
  id          String   @id @default(uuid())
  nom         String
  slug        String   @unique
  description String?
  adresse     String?
  ville       String?
  region      String?
  telephone   String?
  email       String?
  siteWeb     String?
  latitude    Float?
  longitude   Float?
  photos      Json     @default("[]")
  statut      String   @default("public")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mentions Mention[]

  @@map("universites")
}

model Mention {
  id            String        @id @default(uuid())
  universiteId  String
  universite    Universite    @relation(fields: [universiteId], references: [id], onDelete: Cascade)
  domaineId     String
  domaine       Domaine       @relation(fields: [domaineId], references: [id], onDelete: Restrict)
  nom           String
  slug          String        @unique
  description   String?
  niveau        NiveauMention @default(LICENCE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  parcours Parcours[]

  @@map("mentions")
}

model Parcours {
  id               String   @id @default(uuid())
  mentionId        String
  mention          Mention  @relation(fields: [mentionId], references: [id], onDelete: Cascade)
  nom              String
  slug             String   @unique
  description      String?
  duree            String?
  conditionsAcces  String?
  debouches        String?
  fraisAnnuels     Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("parcours")
}

model Stage {
  id                    String    @id @default(uuid())
  titre                 String
  entreprise            String
  description           String?
  domaineId             String?
  domaine               Domaine?  @relation(fields: [domaineId], references: [id], onDelete: SetNull)
  duree                 String?
  dateDebut             DateTime?
  dateLimiteCandidature DateTime?
  region                String?
  niveauEtude           String?
  remuneration          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("stages")
}

model Bourse {
  id          String    @id @default(uuid())
  nom         String
  organisme   String
  pays        String?
  domaineId   String?
  domaine     Domaine?  @relation(fields: [domaineId], references: [id], onDelete: SetNull)
  niveauEtude String?
  montant     String?
  dateLimite  DateTime?
  conditions  String?
  lien        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("bourses")
}

model Blog {
  id          String    @id @default(uuid())
  titre       String
  slug        String    @unique
  contenu     String
  image       String?
  categorie   String?
  auteurId    String
  auteur      Utilisateur @relation(fields: [auteurId], references: [id], onDelete: Restrict)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  likes        BlogLike[]
  commentaires BlogCommentaire[]

  @@map("blogs")
}

model BlogLike {
  id            String      @id @default(uuid())
  blogId        String
  blog          Blog        @relation(fields: [blogId], references: [id], onDelete: Cascade)
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([blogId, utilisateurId])
  @@map("blog_likes")
}

model BlogCommentaire {
  id            String            @id @default(uuid())
  blogId        String
  blog          Blog              @relation(fields: [blogId], references: [id], onDelete: Cascade)
  utilisateurId String
  utilisateur   Utilisateur       @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  contenu       String
  statut        CommentaireStatut @default(EN_ATTENTE)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("blog_commentaires")
}

model Questionnaire {
  id          String   @id @default(uuid())
  titre       String
  description String?
  type        String?  @default("RIASEC")
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions Question[]
  resultats ResultatOrientation[]

  @@map("questionnaires")
}

model Question {
  id              String        @id @default(uuid())
  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  texte           String
  type            TypeQuestion  @default(CHOIX_MULTIPLE)
  ordre           Int           @default(0)
  scoreDimensions Json          @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  reponses Reponse[]

  @@map("questions")
}

model Reponse {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  texte      String
  score      Json     @default("{}")
  ordre      Int      @default(0)

  @@map("reponses")
}

model ResultatOrientation {
  id                  String        @id @default(uuid())
  utilisateurId       String
  utilisateur         Utilisateur   @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  questionnaireId     String
  questionnaire       Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Restrict)
  scores              Json
  profilDominant      String?
  domainesRecommandes Json          @default("[]")
  metiersRecommandes  Json          @default("[]")
  reponses            Json          @default("[]")
  createdAt           DateTime      @default(now())

  @@map("resultats_orientation")
}

model CentreFormation {
  id        String   @id @default(uuid())
  nom       String
  slug      String   @unique
  adresse   String?
  ville     String?
  region    String?
  contact   String?
  siteWeb   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("centres_formation")
}

model Coach {
  id              String       @id @default(uuid())
  utilisateurId   String?      @unique
  utilisateur     Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)
  nom             String
  prenom          String
  email           String?
  telephone       String?
  photo           String?
  bio             String?
  specialites     String[]     @default([])
  experience      String?
  disponibilites  String?
  visible         Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  avis CoachAvis[]

  @@map("coachs")
}

model CoachAvis {
  id            String      @id @default(uuid())
  coachId       String
  coach         Coach       @relation(fields: [coachId], references: [id], onDelete: Cascade)
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  note          Int
  commentaire   String?
  createdAt     DateTime    @default(now())

  @@unique([coachId, utilisateurId])
  @@map("coach_avis")
}

model Enseignant {
  id              String           @id @default(uuid())
  utilisateurId   String?          @unique
  utilisateur     Utilisateur?     @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)
  nom             String
  prenom          String
  email           String?
  telephone       String?
  photo           String?
  bio             String?
  matieres        String[]         @default([])
  niveauxEtude    String[]         @default([])
  etablissement   String?
  disponibilites  String?
  visible         Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  avis    EnseignantAvis[]
  seances SeanceCours[]

  @@map("enseignants")
}

model EnseignantAvis {
  id            String      @id @default(uuid())
  enseignantId  String
  enseignant    Enseignant  @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  note          Int
  commentaire   String?
  createdAt     DateTime    @default(now())

  @@unique([enseignantId, utilisateurId])
  @@map("enseignant_avis")
}

model Favori {
  id            String          @id @default(uuid())
  utilisateurId String
  utilisateur   Utilisateur     @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  type          FavorisableType
  entityId      String
  createdAt     DateTime        @default(now())

  @@unique([utilisateurId, type, entityId])
  @@map("favoris")
}

enum TicketStatut {
  OUVERT
  EN_COURS
  RESOLU
  FERME
}

enum TicketPriorite {
  BASSE
  MOYENNE
  HAUTE
}

model Ticket {
  id            String          @id @default(uuid())
  sujet         String
  description   String?
  statut        TicketStatut    @default(OUVERT)
  priorite      TicketPriorite  @default(MOYENNE)
  categorie     String          @default("AUTRE")
  utilisateurId String
  utilisateur   Utilisateur     @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  messages      TicketMessage[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("tickets")
}

model TicketMessage {
  id            String      @id @default(uuid())
  ticketId      String
  ticket        Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  auteurId      String
  auteur        Utilisateur @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  message       String
  createdAt     DateTime    @default(now())

  @@map("ticket_messages")
}

enum TypeRessource {
  COURS
  DOCUMENT
}

model Ressource {
  id           String        @id @default(uuid())
  titre        String
  description  String?
  contenu      String        @db.Text
  type         TypeRessource
  niveauEtude  String        // 'LYCEE', 'NOUVEAU_BACHELIER' ou 'UNIVERSITE'
  categorie    String        // ex: 'Mathématiques', 'Concours Polytechnique', 'Modèle de CV'
  fichierUrl   String?       // Lien de téléchargement optionnel
  dureeLecture String?       // ex: '15 min', '2 pages'
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt


  @@map("ressources")
}

model FaqItem {
  id        String   @id @default(uuid())
  question  String
  reponse   String   @db.Text
  categorie String
  icone     String   @default("❓")
  ordre     Int      @default(0)
  publie    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faq_items")
}

enum ContactStatut {
  NOUVEAU
  LU
  TRAITE
}

model ContactMessage {
  id        String        @id @default(uuid())
  nom       String
  email     String
  sujet     String
  message   String        @db.Text
  statut    ContactStatut @default(NOUVEAU)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("contact_messages")
}

model PointDeVente {
  id        String   @id @default(uuid())
  nom       String
  adresse   String?
  ville     String?
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  secretaires Utilisateur[]       @relation("SecretairesPointDeVente")
  saisies     SaisieJournaliere[]
  mouvements  MouvementCaisse[]

  @@map("points_de_vente")
}

model SaisieJournaliere {
  id             String       @id @default(uuid())
  pointDeVenteId String
  pointDeVente   PointDeVente @relation(fields: [pointDeVenteId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  periode        Periode
  montantGagne   Int          @default(0)
  montantDepense Int          @default(0)

  // Fond de caisse : montant remis au stand en début de période pour rendre la monnaie. Comparé au
  // comptage réel de fin de période (montantCompte) pour détecter les écarts de caisse (erreur, vol).
  fondDeCaisse   Int          @default(0)
  montantCompte  Int?

  saisiParId     String?
  saisiPar       Utilisateur? @relation(fields: [saisiParId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([pointDeVenteId, date, periode])
  @@map("saisies_journalieres")
}

enum TypeMouvement {
  GAGNE
  DEPENSE
}

model MouvementCaisse {
  id             String        @id @default(uuid())
  pointDeVenteId String
  pointDeVente   PointDeVente  @relation(fields: [pointDeVenteId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  periode        Periode
  type           TypeMouvement
  montant        Int
  note           String?
  saisiParId     String?
  saisiPar       Utilisateur?  @relation(fields: [saisiParId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  // Détails d'inscription (optionnels, pertinents uniquement pour un mouvement de type GAGNE)
  nom              String?
  prenom           String?
  contact          String?
  numeroRecu       String?
  filieresInscrites InscriptionFiliere[]
  droitInscription Int?
  reduction        Int?
  noteReduction    String?
  montantTotal     Int?
  montantRestant   Int?

  // Un étudiant qui revient payer le solde restant génère un nouveau mouvement (obligatoire pour
  // que la caisse du jour reste juste) rattaché à l'inscription d'origine plutôt qu'une inscription
  // séparée : le back-office finance peut ainsi afficher un seul étudiant avec son solde à jour.
  inscriptionParentId     String?
  inscriptionParent       MouvementCaisse?  @relation("PaiementsInscription", fields: [inscriptionParentId], references: [id], onDelete: Cascade)
  paiementsComplementaires MouvementCaisse[] @relation("PaiementsInscription")

  @@map("mouvements_caisse")
}

model Filiere {
  id           String    @id @default(uuid())
  nom          String
  prix         Int
  dateConcours DateTime? @db.Date
  actif        Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  inscriptions InscriptionFiliere[]
  montants     FiliereMontant[]
  seances      SeanceCours[]

  @@map("filieres")
}

// Historique des montants proposés pour une filière : un seul est actif à la fois,
// c'est celui-ci qui est reflété sur Filiere.prix.
model FiliereMontant {
  id        String   @id @default(uuid())
  filiereId String
  filiere   Filiere  @relation(fields: [filiereId], references: [id], onDelete: Cascade)
  montant   Int
  actif     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("filiere_montants")
}

// Table de jonction explicite (plutôt qu'une m2m implicite) car chaque filière suivie par un même
// étudiant peut démarrer à une date différente : la date de début de cours se rattache à la paire
// (mouvement, filière), pas au mouvement seul.
model InscriptionFiliere {
  id             String          @id @default(uuid())
  mouvementId    String
  mouvement      MouvementCaisse @relation(fields: [mouvementId], references: [id], onDelete: Cascade)
  filiereId      String
  filiere        Filiere         @relation(fields: [filiereId], references: [id], onDelete: Restrict)
  dateDebutCours DateTime?       @db.Date
  dateFinCours   DateTime?       @db.Date

  @@unique([mouvementId, filiereId])
  @@map("inscriptions_filieres")
}

model DroitInscription {
  id        String   @id @default(uuid())
  montant   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("droit_inscription")
}

model DepenseGlobale {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  categorie   String
  montant     Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("depenses_globales")
}

// Budget mensuel prévu par catégorie de dépense (les mêmes catégories libres que DepenseGlobale),
// comparé aux dépenses réelles du mois pour calculer un écart. Réservé à ADMIN/MODERATEUR_FINANCE.
model BudgetCategorie {
  id        String   @id @default(uuid())
  categorie String
  annee     Int
  mois      Int
  montant   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categorie, annee, mois])
  @@map("budgets_categories")
}

// Décomposition d'une ligne de budget (ex: "Salaires") en postes individuels calculés
// (taux × quantité × nombre de périodes + ajustement optionnel), pour que le montant total de la
// catégorie reste toujours la somme exacte de ce qui le compose plutôt qu'un chiffre saisi à la main.
model BudgetDetailLigne {
  id                String   @id @default(uuid())
  categorie         String
  annee             Int
  mois              Int
  description       String
  tauxUnitaire      Int
  quantite          Float
  unite             String?
  nombrePeriodes    Float    @default(1)
  ajustementMontant Int?
  ajustementNote    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("budget_detail_lignes")
}

enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

// Catalogue des salles physiques disponibles, avec leur capacité — saisi en amont par l'admin
// plutôt que du texte libre, pour permettre de vérifier la disponibilité d'une salle par créneau.
model Salle {
  id        String   @id @default(uuid())
  nom       String   @unique
  capacite  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seances SeanceCours[]

  @@map("salles")
}

// Créneau hebdomadaire récurrent (pas une séance datée) : "tous les lundis 8h-10h", pas une date
// calendaire précise. Le conflit d'enseignant/salle est vérifié à la création/modification.
// Une matière commune (ex: "Anglais général") peut être enseignée en même temps à plusieurs
// filières par un seul enseignant : la séance se rattache donc à N filières, pas une seule.
model SeanceCours {
  id           String      @id @default(uuid())
  matiere      String
  filieres     Filiere[]
  enseignantId String
  enseignant   Enseignant  @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  jour         JourSemaine
  heureDebut   String
  heureFin     String
  salleId      String
  salle        Salle       @relation(fields: [salleId], references: [id], onDelete: Restrict)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("seances_cours")
}

enum TypeInvestissement {
  DON
  PRET
  APPORT_CAPITAL
}

enum StatutInvestissement {
  PROMIS
  RECU
}

model Investissement {
  id          String               @id @default(uuid())
  date        DateTime             @db.Date
  bailleur    String
  montant     Int
  type        TypeInvestissement   @default(APPORT_CAPITAL)
  statut      StatutInvestissement @default(RECU)
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("investissements")
}
